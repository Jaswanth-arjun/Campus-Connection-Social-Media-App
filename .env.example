EXPO_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
EXPO_PUBLIC_FIREBASE_APP_ID=your_app_id

# AWS S3 Configuration (optional - falls back to Firebase Storage if not set)
EXPO_PUBLIC_AWS_REGION=ap-south-1
EXPO_PUBLIC_AWS_ACCESS_KEY_ID=your_aws_access_key
EXPO_PUBLIC_AWS_SECRET_ACCESS_KEY=your_aws_secret_key
EXPO_PUBLIC_AWS_S3_BUCKET=your_s3_bucket_name

# AWS Lambda + API Gateway (optional - enables AI moderation, Comprehend NLP, Rekognition, analytics)
EXPO_PUBLIC_LAMBDA_API_URL=https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com/prod
