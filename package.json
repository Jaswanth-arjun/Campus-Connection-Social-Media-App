{
  "name": "campus-connect",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "start:clear": "expo start --clear",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:dev": "eas build --platform android --profile development",
    "build:emulator": "eas build --platform android --profile emulator",
    "build:preview": "eas build --platform android --profile preview",
    "build:preview:local": "eas build --platform android --profile preview --local",
    "build:production": "eas build --platform android --profile production",
    "update:preview": "eas update --channel preview --message",
    "update:dev": "eas update --channel development --message",
    "update:production": "eas update --channel production --message",
    "submit:android": "eas submit --platform android",
    "emulator:list": "emulator -list-avds",
    "emulator:start": "emulator @Pixel_7_API_34 -gpu host",
    "emulator:install": "adb install -r",
    "dev:android": "run-app.bat",
    "lint": "expo lint"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@types/react": "~19.2.14",
    "date-fns": "^3.3.1",
    "expo": "^56.0.8",
    "expo-constants": "~56.0.16",
    "expo-document-picker": "~56.0.4",
    "expo-file-system": "~56.0.7",
    "expo-font": "~56.0.5",
    "expo-image-picker": "~56.0.15",
    "expo-linking": "~56.0.13",
    "expo-notifications": "~56.0.15",
    "expo-router": "~56.2.8",
    "expo-secure-store": "~56.0.4",
    "expo-status-bar": "~56.0.4",
    "expo-updates": "~56.0.17",
    "firebase": "^10.8.0",
    "nativewind": "^2.0.11",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-toast-message": "^2.2.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.8.3",
    "typescript": "~6.0.3",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "autoprefixer": "^10.5.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.3.2"
  },
  "private": true
}
