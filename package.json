{
  "name": "campus-connect",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "start:clear": "expo start --clear",
    "android": "expo run:android",
    "android:emulator": "expo start --android --clear",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:dev": "eas build --platform android --profile development",
    "build:emulator": "eas build --platform android --profile emulator",
    "build:preview": "eas build --platform android --profile preview",
    "build:preview:local": "eas build --platform android --profile preview --local",
    "build:production": "eas build --platform android --profile production",
    "update:preview": "eas update --channel preview --message",
    "update:dev": "eas update --channel development --message",
    "update:production": "eas update --channel production --message",
    "submit:android": "eas submit --platform android",
    "emulator:list": "emulator -list-avds",
    "emulator:start": "emulator @Pixel_7_API_34 -gpu host",
    "emulator:install": "adb install -r",
    "dev:android": "run-app.bat",
    "lint": "expo lint"
  },
  "dependencies": {
    "@expo/vector-icons": "^14.0.0",
    "@react-native-async-storage/async-storage": "1.21.0",
    "@types/react": "~18.2.0",
    "date-fns": "^3.3.1",
    "expo": "~50.0.0",
    "expo-constants": "~15.4.6",
    "expo-document-picker": "~11.10.0",
    "expo-file-system": "~16.0.0",
    "expo-image-picker": "~14.7.0",
    "expo-notifications": "~0.27.0",
    "expo-router": "~3.4.10",
    "expo-secure-store": "~12.8.0",
    "expo-updates": "~0.24.0",
    "firebase": "^10.8.0",
    "nativewind": "^4.0.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-native": "0.73.6",
    "react-native-gesture-handler": "~2.14.0",
    "react-native-reanimated": "~3.6.0",
    "react-native-safe-area-context": "4.8.2",
    "react-native-screens": "~3.29.0",
    "react-native-toast-message": "^2.2.0",
    "react-native-web": "~0.19.6",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.9.3",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "tailwindcss": "3.3.2"
  },
  "private": true
}
