{
  "name": "campus-connect",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "start:clear": "expo start --clear",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:dev": "eas build --platform android --profile development",
    "build:emulator": "eas build --platform android --profile emulator",
    "build:preview": "eas build --platform android --profile preview",
    "build:preview:local": "eas build --platform android --profile preview --local",
    "build:production": "eas build --platform android --profile production",
    "update:preview": "eas update --channel preview --message",
    "update:dev": "eas update --channel development --message",
    "update:production": "eas update --channel production --message",
    "submit:android": "eas submit --platform android",
    "emulator:list": "emulator -list-avds",
    "emulator:start": "emulator @Pixel_7_API_34 -gpu host",
    "emulator:install": "adb install -r",
    "dev:android": "run-app.bat",
    "lint": "expo lint"
  },
  "dependencies": {
    "@expo/vector-icons": "^14.0.3",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@types/react": "~18.2.79",
    "date-fns": "^3.3.1",
    "expo": "~51.0.39",
    "expo-av": "~14.0.5",
    "expo-constants": "~16.0.2",
    "expo-document-picker": "~12.0.2",
    "expo-file-system": "~17.0.1",
    "expo-font": "~12.0.10",
    "expo-image-picker": "~15.1.0",
    "expo-linking": "~6.3.1",
    "expo-notifications": "~0.28.19",
    "expo-router": "~3.5.24",
    "expo-screen-capture": "~6.0.1",
    "expo-secure-store": "~13.0.2",
    "expo-status-bar": "~1.12.1",
    "expo-updates": "~0.25.28",
    "firebase": "^10.8.0",
    "nativewind": "^2.0.11",
    "react": "^18.2.0",
    "react-dom": "18.2.0",
    "react-native": "^0.74.5",
    "react-native-gesture-handler": "~2.16.1",
    "react-native-reanimated": "~3.10.1",
    "react-native-safe-area-context": "4.10.5",
    "react-native-screens": "3.31.1",
    "react-native-toast-message": "^2.2.0",
    "react-native-web": "~0.19.10",
    "typescript": "~5.3.3",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "autoprefixer": "^10.5.0",
    "eslint": "^8.57.0",
    "eslint-config-expo": "~7.1.2",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.3.2"
  },
  "private": true
}
